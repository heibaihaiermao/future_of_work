digraph G {
    rankdir=LR;
    
    subgraph cluster_legend {
        label="Legend";
        style=dotted;
        
        // Create nodes for different relationship types
        node [shape=plaintext];
        leg_1 [label="Type 1"];
        leg_2 [label="Type 2"];
        leg_3 [label="Type 3"];
        
        // Create invisible nodes for arrows
        invis1 [shape=point, width=0];
        invis2 [shape=point, width=0];
        invis3 [shape=point, width=0];
        invis4 [shape=point, width=0];
        invis5 [shape=point, width=0];
        invis6 [shape=point, width=0];
        
        // Create example edges
        invis1 -> invis2 [color=red, label="depends on"];
        invis3 -> invis4 [color=blue, style=dashed, label="references"];
        invis5 -> invis6 [color=green, style=dotted, label="includes"];
        
        // Arrange legend items vertically
        {rank=same; leg_1 invis1 invis2}
        {rank=same; leg_2 invis3 invis4}
        {rank=same; leg_3 invis5 invis6}
    }
    
    // Your actual graph
    A -> B [color=red];
    B -> C [color=blue, style=dashed];
    C -> D [color=green, style=dotted];
}
