digraph G1 {
    // Actual graph
    node [shape=box];
    A -> B;
    B -> C;
    C -> D [dir=back];

  subgraph {
        // Legend nodes
        nodesep=1;
        ranksep=1;



        legend1 [shape=plaintext; label="depends on"];
        point1 [shape=point; width=0.01];
	
        
        // Trapezoid for legend
        leg_trap1 [shape=trapezium; label=""; width=0.3; height=0.3];
        //{rank=same; point2; leg_trap2}
	//{rank=min; legend1; legend2}
        {rank=same; point1; leg_trap1};
        legend1 -> leg_trap1 [style=invis];
        leg_trap1 -> point1 [constraint=false];


        legend2 [shape=plaintext; label="required by"];
        point2 [shape=point; width=0.01];
        leg_trap2 [shape=trapezium; label=""; width=0.3; height=0.3];
        {rank=same; point2; leg_trap2};


        //legend2 -> leg_trap2 [style=invis; maxlen=0.2; minlen=0.2];
        legend2 -> leg_trap2 [style=invis; len=0.1];
        // Legend arrows
        point2 -> leg_trap2 [constraint=false];
	
	// invisible connection for ordering.
	leg_trap1 -> legend2 [style=invis];
    }

   
    // Force legend items together in top right
    //{rank=source; legend1 legend2 leg_trap1 leg_trap2}
    //{rank=source; legend1; legend2}
    
}
