  n5 -> o3 [label="yes"];
  n6 -> o1 [label="no"];
  n6 -> o2 [xlabel="on-demand"];
  n6 -> o3 [label="scheduled"];
  n3 -> o3 [label="no"];
  n4 -> o4 [label="no"];

}
