digraph workflow {
  fontname="Helvetica,Arial,sans-serif"
  node [fontname="Helvetica,Arial,sans-serif"]
  edge [fontname="Helvetica,Arial,sans-serif"]

  subgraph alice {
    ha;
    a;
    ha -> a;
  }

  subgraph bob {
    hb;
    b;
    eb;
    hb -> b;
    b -> eb;
  }

  a -> hb [constraint=false];
  a -> b[constraint=false];
  a -> eb[constraint=false];

}
